<!-- Target Path in Repo: src/xbox/MainPage.xaml -->
<Page
    x:Class="EglantineXbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#0A0D10">

    <Grid Padding="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Eglantine NX2 — Xbox Dev Mode Runner"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#F8FAFC"/>
            <TextBlock Text="Switch 2 (NX2) Loose ExeFS Headless Kernel &amp; SVC Debug Console"
                       FontSize="16"
                       Foreground="#94A3B8"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Status Message -->
        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="1"
                   Text="Insert a USB drive containing your loose Switch 2 ExeFS folder (main + main.npdm)."
                   FontSize="15"
                   Foreground="#38BDF8"
                   Margin="0,0,0,24"/>

        <!-- 10-Foot / Gamepad Friendly Action Controls -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,24">
            <Button x:Name="PickFolderButton"
                    Content="1. Pick ExeFS Folder (USB)"
                    Click="OnPickFolderClicked"
                    Background="#1E293B"
                    Foreground="#FFFFFF"
                    FontSize="16"
                    Padding="24,12"
                    Margin="0,0,16,0"/>

            <Button x:Name="BootButton"
                    Content="2. Boot NX2 Kernel"
                    Click="OnBootClicked"
                    IsEnabled="False"
                    Background="#2563EB"
                    Foreground="#FFFFFF"
                    FontSize="16"
                    Padding="24,12"
                    Margin="0,0,16,0"/>

            <Button x:Name="StopButton"
                    Content="Stop Core"
                    Click="OnStopClicked"
                    IsEnabled="False"
                    Background="#DC2626"
                    Foreground="#FFFFFF"
                    FontSize="16"
                    Padding="24,12"
                    Margin="0,0,16,0"/>

            <Button x:Name="ClearLogsButton"
                    Content="Clear Log"
                    Click="OnClearLogsClicked"
                    Background="#334155"
                    Foreground="#FFFFFF"
                    FontSize="16"
                    Padding="24,12"/>
        </StackPanel>

        <!-- Real-Time Kernel / Syscall Log Console -->
        <Border Grid.Row="3"
                Background="#050709"
                BorderBrush="#1E293B"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16">
            <ScrollViewer x:Name="LogScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogTextBlock"
                           FontFamily="Consolas, Courier New"
                           FontSize="13"
                           Foreground="#4ADE80"
                           Text="[Ready] Eglantine Xbox UWP Runner initialized. Connect a USB drive and select your NX2 ExeFS folder to begin.&#x0a;"
                           TextWrapping="NoWrap"
                           IsTextSelectionEnabled="True"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
